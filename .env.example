# Required: Google Cloud Project ID
PROJECT_ID=your-gcp-project-id

# Optional: BigQuery settings (defaults derived from PROJECT_ID if omitted)
BQ_DATASET=product_enrichment
BQ_SOURCE_DATASET=ai_commerce_search_dataset
BQ_SOURCE_TABLE_NAME=products_aics
# BQ_SOURCE_TABLE=your-gcp-project-id.ai_commerce_search_dataset.products_aics
BQ_LOCATION=US

# Optional: Vertex AI Gemini models
GEMINI_MODEL=gemini-3.8-flash
VERTEX_LOCATION=global
THINKING_LEVEL=LOW
BATCH_MODEL=gemini-3.8-flash
BATCH_LOCATION=global

# Optional: Seasonal image generation & GCS bucket (defaults to products_images_${PROJECT_ID})
# IMAGE_BUCKET=products_images_your-gcp-project-id
IMAGE_MODEL=gemini-3.1-flash-image
IMAGE_MODEL_PRO=gemini-3-pro-image
IMAGE_DEFAULT_SIZE=300
PUBLIC_BASE_URL=
UPDATE_AICS=true

# Optional: Cloud Run deployment (used by deploy.sh)
REGION=asia-northeast1
SERVICE_NAME=aics-data-enrichment
